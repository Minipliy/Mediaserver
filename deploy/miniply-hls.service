# Optional: HLS copies for adaptive video. Only runs when started by hand:
#   sudo systemctl start miniply-hls
# First run scripts/prepare-hls.py with --dry-run and --benchmark, see docs/SETUP.md.
[Unit]
Description=Prepare HLS copies for Mediaserver
RequiresMountsFor=/srv/media
AssertPathIsMountPoint=/srv/media

[Service]
Type=oneshot
User=miniply
Group=media
ExecStartPre=/usr/bin/mountpoint -q /srv/media
ExecStart=/usr/bin/python3 /usr/local/lib/miniply/prepare-hls.py /srv/media --threads 1
UMask=0022
Nice=19
IOSchedulingClass=idle
TimeoutStartSec=infinity
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX
ReadOnlyPaths=/srv/media
ReadWritePaths=/srv/media/.miniply-hls
MemoryMax=768M
TasksMax=32
