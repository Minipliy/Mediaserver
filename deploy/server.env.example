# Install as /etc/miniply/server.env, owned by root, mode 0600.
# Generate the token ON YOUR DEVICE: openssl rand -hex 32
MINIPLY_TOKEN=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
MINIPLY_MEDIA_ROOT=/srv/media
MINIPLY_DATABASE=/var/lib/miniply/miniply.sqlite
MINIPLY_BIND=10.77.0.2:8080
MINIPLY_SCAN_SECONDS=60
# Online-Infos (iTunes Search, Wikipedia, TVmaze) für Alben, Interpreten,
# Titel, Serien und Filme. 0 schaltet sie ab.
MINIPLY_ONLINE_METADATA=1
RUST_LOG=miniply_server=info
# Upload aus der App (POST /v1/upload). Braucht Schreibrechte, siehe
# deploy/miniply-uploads.conf und docs/SETUP.md. 0 = aus.
MINIPLY_UPLOADS=0
# Löschen aus der App (POST /v1/media/delete). Braucht dieselben Schreibrechte.
# Gelöschtes bleibt 14 Tage in .miniply-papierkorb auf der SSD. 0 = aus.
MINIPLY_DELETES=0
# Standbilder für Videos ohne Poster (braucht ffmpeg). 0 = aus.
MINIPLY_THUMBNAILS=1
