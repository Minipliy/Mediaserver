[Unit]
Description=Mediaserver isolated App Review demo
After=network.target

[Service]
Type=simple
User=mediaserver-review
Group=mediaserver-review
EnvironmentFile=/etc/mediaserver-review.env
ExecStart=/usr/local/bin/mediaserver-review
WorkingDirectory=/var/lib/mediaserver-review
StateDirectory=mediaserver-review
StateDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadOnlyPaths=/srv/mediaserver-review-media
ReadWritePaths=/var/lib/mediaserver-review
MemoryMax=96M
CPUQuota=25%
TasksMax=32

[Install]
WantedBy=multi-user.target
