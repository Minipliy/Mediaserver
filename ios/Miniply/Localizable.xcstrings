    "Du folgst noch niemandem. Tippe auf der Seite eines Künstlers auf „Folgen“." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du folgst noch niemandem. Tippe auf der Seite eines Künstlers auf „Folgen“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You are not following anyone yet. Tap “Follow” on an artist’s page."
          }
        }
      }
    },
    "Seit %@" : {
