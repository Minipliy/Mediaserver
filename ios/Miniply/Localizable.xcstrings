    },
    "„%@“ wird hinzugefügt." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ wird hinzugefügt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” will be added."
          }
        }
      }
    },
    "„Stabil“ lädt mehr im Voraus und stockt seltener. „Datensparend“ lädt nur wenige Sekunden voraus und verbraucht weniger Daten, wenn du früh abbrichst. Im Datensparmodus von iOS gilt immer „Datensparend“ und niedrige Videoqualität. Die Videoqualität wirkt bei Videos, für die der Server eine HLS-Kopie vorbereitet hat; alle anderen spielen in ihrer Originalqualität." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Stabil“ lädt mehr im Voraus und stockt seltener. „Datensparend“ lädt nur wenige Sekunden voraus und verbraucht weniger Daten, wenn du früh abbrichst. Im Datensparmodus von iOS gilt immer „Datensparend“ und niedrige Videoqualität. Die Videoqualität wirkt bei Videos, für die der Server eine HLS-Kopie vorbereitet hat; alle anderen spielen in ihrer Originalqualität."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Stable” loads more ahead and stalls less often. “Data saver” loads only a few seconds ahead and uses less data if you stop early. In iOS Low Data Mode, “Data saver” and low video quality always apply. Video quality takes effect for videos with an HLS copy prepared by the server; all others play in their original quality."
          }
        }
      }
    },
