    },
    "Veröffentlicht einer dieser Künstler etwas Neues, lädt dein Server es automatisch. Die App legt es auf dieses Gerät und zeigt es auf der Startseite." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veröffentlicht einer dieser Künstler etwas Neues, lädt dein Server es automatisch. Die App legt es auf dieses Gerät und zeigt es auf der Startseite."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When one of these artists releases something new, your server loads it automatically. The app saves it on this device and shows it on the home screen."
          }
        }
      }
    },
    "Auf deinem Server ist der Musik-Dienst nicht eingerichtet. Die Künstler werden gemerkt, neue Songs aber nicht geladen." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf deinem Server ist der Musik-Dienst nicht eingerichtet. Die Künstler werden gemerkt, neue Songs aber nicht geladen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The music service is not set up on your server. The artists are remembered, but new songs are not loaded."
          }
        }
      }
    },
