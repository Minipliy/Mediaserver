    "Schon auf dem Server" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schon auf dem Server"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Already on the server"
          }
        }
      }
    },
    "Songs werden am Ende ausgeblendet und der nächste eingeblendet. Aufeinanderfolgende Songs eines Albums laufen ohne Pause und ohne Blende ineinander. „Lautstärke angleichen“ nutzt ReplayGain-Werte aus den Dateien, sonst die vom Server gemessene Lautheit. Gilt ab dem nächsten Song." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Songs werden am Ende ausgeblendet und der nächste eingeblendet. Aufeinanderfolgende Songs eines Albums laufen ohne Pause und ohne Blende ineinander. „Lautstärke angleichen“ nutzt ReplayGain-Werte aus den Dateien, sonst die vom Server gemessene Lautheit. Gilt ab dem nächsten Song."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Songs fade out at the end and the next one fades in. Consecutive songs of an album run into each other without a gap or fade. “Level volume” uses ReplayGain values from the files, otherwise the loudness measured by the server. Applies from the next song."
          }
        }
      }
    },
    "Songs, die du oft gehört hast, erscheinen hier, wenn du sie einen Monat nicht mehr gespielt hast." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Songs, die du oft gehört hast, erscheinen hier, wenn du sie einen Monat nicht mehr gespielt hast."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Songs you played often appear here when you have not played them for a month."
          }
        }
      }
    },
