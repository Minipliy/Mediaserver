        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The track list could not be loaded."
          }
        }
      }
    },
    "Geladen wird die Originalaufnahme, immer unzensiert. Findet der Server sie nicht sicher, lässt er den Song aus." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geladen wird die Originalaufnahme, immer unzensiert. Findet der Server sie nicht sicher, lässt er den Song aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The server loads the original recording, always uncensored. If it cannot find it with certainty, it skips the song."
          }
        }
      }
    },
    " " : {
      "shouldTranslate" : false
    },
